# MongoDB Atlas connection string
URL=mongodb+srv://USER:PASS@cluster.mongodb.net/chat
# string acak panjang untuk JWT & hash OTP
SECRET=ganti-dengan-string-acak-panjang
# Token device Fonnte (https://md.fonnte.com -> Device -> Token)
FONNTE_TOKEN=
# URL frontend (pisahkan koma jika lebih dari satu), tanpa slash di akhir
BASE_URL=http://localhost:3000
